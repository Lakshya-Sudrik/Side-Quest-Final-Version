# YouTube Data API v3 key - used by the "is this gem real?" check (src/youtube_verify.py)
YOUTUBE_API_KEY=""

# Database. Leave blank for SQLite (data/app/sidequest.db, zero setup).
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/sidequest
DATABASE_URL=""

# Comma-separated emails that become admins (they verify collaborators)
SIDEQUEST_ADMIN_EMAILS=""

# Optional: Gemini API key
GEMINI_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# Nugen keys and aligned model IDs stay on the server. Leave the aligned model
# blank to auto-select only when exactly one deployed aligned model is present.
NUGEN_API_KEY=""
NUGEN_ALIGNED_MODEL_ID=""

# Optional live weather data provider (server-side only)
WEATHER_API_KEY=""

# Optional: Python executable and port for the FastAPI backend
# PYTHON_PATH="python3"
# PY_API_URL="http://127.0.0.1:8000"
