      "label": "Home page on desktop"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home page on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Discover Hidden Gems",
      "short_name": "Discover",
      "description": "Find hidden gems near you",
      "url": "/discover",
      "icons": [
        {
          "src": "/icons/discover.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Find Solo Travelers",
      "short_name": "Solo",
      "description": "Connect with other solo travelers",
      "url": "/solo-match",
      "icons": [
        {
          "src": "/icons/solo.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Safety Info",
      "short_name": "Safety",
      "description": "Check safety information",
      "url": "/safety",
      "icons": [
        {
          "src": "/icons/safety.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "background_fetch": {
    "enabled": true,
    "default_minimum_interval": 60
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/*"]
